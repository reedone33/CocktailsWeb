<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- A name for this job. Must match the filename. -->
  <key>Label</key>
  <string>com.reed.cocktailsweb</string>

  <!-- What to run: the publish script, in unattended mode. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/reed/Library/CloudStorage/OneDrive-Personal/0 Claude Cowork Playground/Cocktails/CocktailsWeb/publish.sh</string>
    <string>--auto</string>
  </array>

  <!-- When to run it: whenever anything in the Cocktails FOLDER changes.
       Watching the folder rather than the workbook itself is deliberate.
       Excel and openpyxl never edit a file in place - they write a temp file
       and rename it over the original, which replaces the underlying inode.
       A watch pointed at the file is then watching something that no longer
       exists and stops firing. The rename does show up as a change to the
       folder, so that is what we watch.

       The cost is that any change in the folder wakes the job. That is fine:
       publish.sh exits in about two seconds unless the workbook is actually
       newer than the last publish. -->
  <key>WatchPaths</key>
  <array>
    <string>/Users/reed/Library/CloudStorage/OneDrive-Personal/0 Claude Cowork Playground/Cocktails</string>
  </array>

  <!-- Background jobs get a bare-bones PATH, so spell it out. Homebrew paths
       are included in case python3 or git come from there. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Don't run at login, and don't restart if it exits. It should only ever
       run in response to the workbook changing. -->
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>

  <!-- Anything the script prints that isn't already in its own log. -->
  <key>StandardOutPath</key>
  <string>/Users/reed/Library/Logs/cocktailsweb-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/reed/Library/Logs/cocktailsweb-launchd.log</string>
</dict>
</plist>
